{
  "server": {
    "name": "issue-tracker",
    "version": "1.4.0"
  },
  "tools": [
    {
      "name": "search_issues",
      "description": "Search issues in a repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text."
          },
          "state": {
            "enum": [
              "open",
              "closed",
              "all"
            ],
            "default": "open"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "create_issue",
      "description": "Create a new issue in a repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "get_file",
      "description": "Read a file from the repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "path"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_branches",
      "description": "List the branches of a repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}